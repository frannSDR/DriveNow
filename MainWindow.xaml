<Window x:Class="DriveNow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drive Now - Panel de Administración" 
        Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0F172A">

    <Window.Resources>
        <!-- Estilo Principal para Botones de Navegación -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borderContenedor"
                            Background="{TemplateBinding Background}" 
                            BorderThickness="0" 
                            CornerRadius="7">
                            <Grid>
                                <!-- Indicador de barra vertical activa -->
                                <Border x:Name="indicadorActivo"
                                    Width="3" HorizontalAlignment="Left"
                                    Background="#38BDF8" CornerRadius="2"
                                    Visibility="Collapsed" Margin="0,6"/>

                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- 1. Estado Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borderContenedor" Property="Background" Value="#283548"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>

                            <!-- 2. Estado Click / Presionado -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="borderContenedor" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>

                            <!-- 3. Estado Activo/Seleccionado (Activado mediante Tag) -->
                            <Trigger Property="Tag" Value="Activo">
                                <Setter TargetName="borderContenedor" Property="Background" Value="#1E3A8A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="indicadorActivo" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Cerrar Sesión (Alerta Suave) -->
        <Style x:Key="SidebarLogoutButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borderLogout" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="Center" 
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borderLogout" Property="Background" Value="#450A0A"/>
                                <Setter Property="Foreground" Value="#FCA5A5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="borderLogout" Property="Background" Value="#2B0505"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">

                <!-- Logo y Título -->
                <StackPanel DockPanel.Dock="Top" Margin="20,25,20,30">
                    <TextBlock Text="Drive Now" FontSize="24" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="Panel de Administración" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Botones Principales -->
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="btnNavDashboard" Content="📊   Dashboard" Style="{StaticResource SidebarNavButtonStyle}" Click="btnNavDashboard_Click"/>
                    <Button x:Name="btnNavFlota" Content="🚗   Gestión de Flota" Style="{StaticResource SidebarNavButtonStyle}" Click="btnNavFlota_Click"/>
                    <Button x:Name="btnNavClientes" Content="👥   Gestión de Clientes" Style="{StaticResource SidebarNavButtonStyle}" Click="btnNavClientes_Click"/>
                    <Button x:Name="btnNavReservas" Content="📅   Gestión de Reservas" Style="{StaticResource SidebarNavButtonStyle}" Click="btnNavReservas_Click"/>
                    <Button x:Name="btnNavAlquileres" Content="🔑   Gestión de Alquileres" Style="{StaticResource SidebarNavButtonStyle}" Click="btnNavAlquileres_Click"/>

                    <!-- Nueva pestaña: Historial personal del operador -->
                    <Button x:Name="btnNavMisOperaciones" Content="📋   Mis Operaciones" Style="{StaticResource SidebarNavButtonStyle}" Click="btnNavMisOperaciones_Click"/>

                    <!-- Módulos con restricción -->
                    <Button x:Name="btnNavReportes" Content="📈   Reportes y Finanzas" Style="{StaticResource SidebarNavButtonStyle}" Click="btnNavReportes_Click"/>
                    <Button x:Name="btnNavUsuarios" Content="🛡️   Gestión de Personal" Style="{StaticResource SidebarNavButtonStyle}" Click="btnNavUsuarios_Click"/>
                    <Button x:Name="btnNavCategorias" Content="🏷️   Tarifas y Categorías" Style="{StaticResource SidebarNavButtonStyle}" Click="btnNavCategorias_Click"/>
                    <Button x:Name="btnNavTaller" Content="🔧   Taller y Mantenimiento" Style="{StaticResource SidebarNavButtonStyle}" Click="btnNavTaller_Click"/>
                </StackPanel>

                <!-- Sección Inferior -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,15">
                    <Button x:Name="btnNavCuenta" Content="⚙️   Mi Cuenta" Style="{StaticResource SidebarNavButtonStyle}" Click="btnNavCuenta_Click"/>
                    <Button x:Name="btnCerrarSesion" Content="🚪   Cerrar Sesión" Style="{StaticResource SidebarLogoutButtonStyle}" Click="btnCerrarSesion_Click"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Contenedor Dinámico de Vistas -->
        <ContentControl x:Name="ContenedorPrincipal" Grid.Column="1" Margin="20"/>

    </Grid>
</Window>