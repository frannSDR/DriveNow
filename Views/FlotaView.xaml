<UserControl x:Class="DriveNow.Views.FlotaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Encabezado y KPIs -->
            <RowDefinition Height="*"/>
            <!-- Buscador y DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Formulario de Alta / Edición -->
        </Grid.RowDefinitions>

        <!-- ENCABEZADO Y TARJETAS DE ESTADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <DockPanel LastChildFill="False" Margin="0,0,0,15">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Gestión de flota e inventario" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Administra el inventario de vehículos, estados y asignaciones." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="4">
                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="4">
                    <StackPanel>
                        <TextBlock Text="✅ DISPONIBLES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="lblDisponibles" Text="0" FontSize="24" FontWeight="Bold" Foreground="#4ADE80" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="4">
                    <StackPanel>
                        <TextBlock Text="🔑 ALQUILADOS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="lblAlquilados" Text="0" FontSize="24" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="4">
                    <StackPanel>
                        <TextBlock Text="📅 RESERVADOS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="lblReservados" Text="0" FontSize="24" FontWeight="Bold" Foreground="#60A5FA" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="4">
                    <StackPanel>
                        <TextBlock Text="🔧 MANTENIMIENTO" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="lblMantenimiento" Text="0" FontSize="24" FontWeight="Bold" Foreground="#F87171" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- SECCIÓN DE TABLA Y FILTROS -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra de Búsqueda -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBox x:Name="txtBuscar" Width="300" Height="35" HorizontalAlignment="Left"
                             Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,7"
                             TextChanged="txtBuscar_TextChanged"/>

                    <TextBlock Text="🔍 Buscar patente, modelo..." Foreground="#64748B" IsHitTestVisible="False"
                               Margin="12,8,0,0" HorizontalAlignment="Left">
                        <TextBlock.Visibility>
                            <Binding Path="Text.IsEmpty" ElementName="txtBuscar">
                                <Binding.Converter>
                                    <BooleanToVisibilityConverter/>
                                </Binding.Converter>
                            </Binding>
                        </TextBlock.Visibility>
                    </TextBlock>
                </Grid>

                <!-- DataGrid de Vehículos -->
                <DataGrid x:Name="dgvFlota" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="Transparent" BorderThickness="0" RowHeight="42" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                          SelectionUnit="FullRow" Foreground="White">

                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A8A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A8A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A3A52"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PATENTE" Binding="{Binding Patente}" Width="120" FontWeight="Bold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="16,0,0,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="Padding" Value="16,0,10,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="MARCA/MODELO" Binding="{Binding MarcaModelo}" Width="1.8*"/>
                        <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Categoria.Nombre}" Width="1.5*"/>
                        <DataGridTextColumn Header="AÑO" Binding="{Binding Anio}" Width="80"/>
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado.Nombre}" Width="130"/>

                        <!-- Columna de Acciones (Editar y Eliminar) -->
                        <DataGridTemplateColumn x:Name="colAccionesFlota" Header="ACCIONES" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Botón Editar -->
                                        <Button Content="✏️" Background="Transparent" Foreground="#38BDF8" 
                                                BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                                                ToolTip="Editar datos del vehículo"
                                                Click="btnEditarVehiculo_Click"/>

                                        <!-- Botón Eliminar -->
                                        <Button Content="🗑️" Background="Transparent" Foreground="#F87171" 
                                                BorderThickness="0" Cursor="Hand" 
                                                ToolTip="Eliminar vehículo"
                                                Click="btnEliminarFila_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- FORMULARIO DE ALTA / EDICIÓN DE VEHÍCULO -->
        <Border x:Name="pnlFormularioVehiculo" Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="15">
            <StackPanel>
                <TextBlock x:Name="lblTituloFormularioFlota" Text="➕ Alta de vehículo" 
                           FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                <!-- Fila 1: Patente, Marca, Modelo -->
                <UniformGrid Columns="3" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Patente" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtPatente" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6" TextChanged="txtBuscar_TextChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Marca" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtMarca" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Modelo" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtModelo" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                    </StackPanel>
                </UniformGrid>

                <!-- Fila 2: Categoría, Año, Estado -->
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Categoría" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbCategoria" Height="35" Background="#0F172A" Foreground="Black" Padding="8,6" 
                                  DisplayMemberPath="Nombre" SelectedValuePath="IdCategoria"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Año" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtAnio" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Estado" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbEstado" Height="35" Background="#0F172A" Foreground="Black" Padding="8,6"
                                  DisplayMemberPath="Nombre" SelectedValuePath="IdEstado"/>
                    </StackPanel>
                </UniformGrid>

                <!-- Botones Guardar / Cancelar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCancelarFlota" Content="Cancelar" Width="100" Height="35" 
                            Background="#475569" Foreground="White" BorderThickness="0" 
                            Margin="0,0,10,0" Cursor="Hand" Visibility="Collapsed" 
                            Click="btnCancelarFlota_Click"/>

                    <Button x:Name="btnLimpiarFlota" Content="Limpiar" Width="100" Height="35" 
                            Background="#334155" Foreground="White" BorderThickness="0" 
                            Margin="0,0,10,0" Cursor="Hand" 
                            Click="btnLimpiarFlota_Click"/>

                    <Button x:Name="btnGuardarVehiculo" Content="Guardar" Width="140" Height="35" 
                            Background="#2563EB" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Cursor="Hand" 
                            Click="btnGuardarVehiculo_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>