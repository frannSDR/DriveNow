<UserControl x:Class="DriveNow.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Encabezado -->
            <RowDefinition Height="*"/>
            <!-- DataGrid de Empleados -->
            <RowDefinition Height="Auto"/>
            <!-- Formulario Alta / Edición -->
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Gestión de Personal y Accesos" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Módulo exclusivo para el SuperAdmin: administración de usuarios y asignación de roles." FontSize="13" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- TABLA DE EMPLEADOS -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Personal Registrado" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtBuscarEmpleado" Width="260" Height="32" HorizontalAlignment="Right"
                             Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,5"
                             TextChanged="txtBuscarEmpleado_TextChanged"/>
                </Grid>

                <DataGrid x:Name="dgvEmpleados" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="Transparent" BorderThickness="0" RowHeight="42" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                          SelectionUnit="FullRow" Foreground="White">

                    <DataGrid.Resources>
                        <!-- Pinceles neutralizados para selección oscura -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A8A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A8A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A3A52"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdEmpleado}" Width="70" FontWeight="Bold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="16,0,0,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="Padding" Value="16,0,10,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="110"/>
                        <DataGridTextColumn Header="NOMBRE COMPLETO" Binding="{Binding NombreCompleto}" Width="1.5*"/>
                        <DataGridTextColumn Header="CORREO" Binding="{Binding Email}" Width="1.8*"/>
                        <DataGridTextColumn Header="ROL" Binding="{Binding Rol.Nombre}" Width="130"/>

                        <DataGridTemplateColumn Header="ACCIONES" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Botón Editar -->
                                        <Button Content="✏️" Background="Transparent" Foreground="#38BDF8" 
                                                BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                                                ToolTip="Editar datos de este empleado"
                                                Click="btnEditarEmpleado_Click"/>

                                        <!-- Botón Eliminar -->
                                        <Button Content="🗑️" Background="Transparent" Foreground="#F87171" 
                                                BorderThickness="0" Cursor="Hand" 
                                                ToolTip="Dar de baja empleado"
                                                Click="btnEliminarEmpleado_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- FORMULARIO DE ALTA / EDICIÓN -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="15">
            <StackPanel>
                <TextBlock x:Name="lblTituloFormulario" Text="➕ Registrar Nuevo Miembro del Personal" 
                           FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                <!-- Fila 1: DNI, Nombre, Apellido -->
                <UniformGrid Columns="3" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="DNI" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtDni" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Nombre" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtNombre" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Apellido" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtApellido" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                    </StackPanel>
                </UniformGrid>

                <!-- Fila 2: Correo, Contraseña, Rol -->
                <UniformGrid Columns="3" Margin="0,0,0,15">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Correo Electrónico" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtEmail" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock x:Name="lblPassAviso" Text="Contraseña Inicial" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="txtPassword" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Rol Asignado" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbRoles" Height="34" Background="#0F172A" Foreground="Black" Padding="8,6" DisplayMemberPath="Nombre" SelectedValuePath="IdRol"/>
                    </StackPanel>
                </UniformGrid>

                <!-- Botones de Acción -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCancelarEdicion" Content="Cancelar" Width="100" Height="35" 
                            Background="#475569" Foreground="White" BorderThickness="0" 
                            Margin="0,0,10,0" Cursor="Hand" Visibility="Collapsed" 
                            Click="btnCancelarEdicion_Click"/>

                    <Button x:Name="btnLimpiar" Content="Limpiar" Width="100" Height="35" 
                            Background="#334155" Foreground="White" BorderThickness="0" 
                            Margin="0,0,10,0" Cursor="Hand" 
                            Click="btnLimpiar_Click"/>

                    <Button x:Name="btnGuardarUsuario" Content="Guardar Usuario" Width="150" Height="35" 
                            Background="#2563EB" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Cursor="Hand" 
                            Click="btnGuardarUsuario_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>