<UserControl x:Class="DriveNow.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="Auto"/>
            <!-- Bloque Superior: Formulario + Validación -->
            <RowDefinition Height="*"/>
            <!-- Bloque Inferior: DataGrid de Clientes -->
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Gestión de clientes" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Administra el padrón de conductores y verifica identidades." FontSize="13" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- PANELES SUPERIORES (Registro a la izquierda, Validación a la derecha) -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- FORMULARIO DE REGISTRO DE CLIENTE -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="👤 Registro de cliente" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                    <!-- Nombre Completo -->
                    <TextBlock Text="Nombre Completo" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNombre" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,10"/>

                    <!-- DNI y Teléfono -->
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="DNI" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtDni" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Teléfono" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtTelefono" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Correo Electrónico -->
                    <TextBlock Text="Correo Electrónico" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCorreo" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,10"/>

                    <!-- N° Licencia y Vencimiento -->
                    <UniformGrid Columns="2" Margin="0,0,0,15">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="N° Licencia" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtLicencia" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Venc. Licencia" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <DatePicker x:Name="dpVencimiento" Height="35"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Botones -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Limpiar" Width="90" Height="35" Background="#334155" Foreground="White" 
                                BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="btnLimpiar_Click"/>
                        <Button Content="Guardar Registro" Width="130" Height="35" Background="#2563EB" Foreground="White" 
                                FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnGuardarCliente_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- MÓDULO DE VALIDACIÓN DE IDENTIDAD -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="15" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="🛡️ Validación de identidad" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                    <!-- Buscador de DNI para validar -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtValidarDni" Grid.Column="0" Height="35" Background="#0F172A" Foreground="White" 
                                 BorderBrush="#334155" Padding="8,6"/>
                        <Button Grid.Column="1" Content="Buscar" Width="75" Height="35" Background="#334155" Foreground="White" 
                                BorderThickness="0" Margin="8,0,0,0" Cursor="Hand" Click="btnBuscarValidacion_Click"/>
                    </Grid>

                    <!-- Tarjeta de Identidad del Conductor -->
                    <Border Background="#0F172A" CornerRadius="6" Padding="15" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <TextBlock x:Name="lblNombreValidado" Text="Seleccione un cliente" FontSize="16" FontWeight="Bold" Foreground="White" DockPanel.Dock="Left"/>
                                <Border x:Name="badgeEstado" Background="#065F46" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right">
                                    <TextBlock x:Name="lblBadgeTexto" Text="VALIDADO" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                            </DockPanel>

                            <TextBlock x:Name="lblDniValidado" Text="DNI: -" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,10"/>

                            <!-- Estado de Licencia -->
                            <TextBlock x:Name="lblVencimientoTexto" Text="Estado de Licencia Vence: -" FontSize="13" Foreground="White" Margin="0,0,0,4"/>
                            <ProgressBar x:Name="pbLicencia" Height="6" Value="100" Foreground="#10B981" Background="#334155" BorderThickness="0" Margin="0,0,0,6"/>
                            <TextBlock x:Name="lblLicenciaEstadoMsg" Text="Licencia válida y en regla" FontSize="11" Foreground="#34D399"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- LISTADO DE CLIENTES -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Listado de clientes" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                <DataGrid x:Name="dgvClientes" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="Transparent" BorderThickness="0" RowHeight="45"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                          Foreground="White" RowBackground="#1E293B" AlternatingRowBackground="#182234"
                          SelectionChanged="dgvClientes_SelectionChanged">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NOMBRE" Binding="{Binding NombreCompleto}" Width="1.5*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="120"/>
                        <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="140"/>
                        <DataGridTextColumn Header="N° LICENCIA" Binding="{Binding NroLicencia}" Width="120"/>
                        <DataGridTextColumn Header="VENCIMIENTO" Binding="{Binding VencimientoFormato}" Width="120"/>
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="100"/>

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="ACCIÓN" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️" Background="Transparent" Foreground="#F87171" 
                                            BorderThickness="0" Cursor="Hand" Click="btnEliminarCliente_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>