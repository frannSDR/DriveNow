<UserControl x:Class="DriveNow.Views.AlquileresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Encabezado y KPIs -->
            <RowDefinition Height="Auto"/>
            <!-- Operaciones (Entrega / Devolución) -->
            <RowDefinition Height="*"/>
            <!-- Historial de Alquileres -->
        </Grid.RowDefinitions>

        <!-- ENCABEZADO Y TARJETAS KPI -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Gestión de Contratos y Alquileres" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

            <UniformGrid Columns="4">
                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="4">
                    <StackPanel>
                        <TextBlock Text="🔑 ALQUILERES ACTIVOS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="lblKpiActivos" Text="0" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="4">
                    <StackPanel>
                        <TextBlock Text="⚠️ CON MORA / RETRASO" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="lblKpiMora" Text="0" FontSize="24" FontWeight="Bold" Foreground="#F87171" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="4">
                    <StackPanel>
                        <TextBlock Text="✅ DEVUELTOS HOY" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="lblKpiDevueltos" Text="0" FontSize="24" FontWeight="Bold" Foreground="#4ADE80" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="4">
                    <StackPanel>
                        <TextBlock Text="🕒 TOTAL HISTÓRICO" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="lblKpiTotal" Text="0" FontSize="24" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- PANELES DE OPERACIÓN: REGISTRAR ENTREGA Y DEVOLUCIÓN -->
        <Grid x:Name="pnlOperacionesAlquiler" Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. REGISTRAR ENTREGA DE VEHÍCULO -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="🚗 Registrar entrega de vehículo (Check-out)" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                    <TextBlock Text="Buscar Reserva (Código, DNI o Cliente)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtBuscarReservaEntrega" Grid.Column="0" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6" TextChanged="txtBuscarReservaEntrega_TextChanged"/>
                        <Button Grid.Column="1" Content="Cargar" Width="65" Height="35" Background="#334155" Foreground="White" BorderThickness="0" Margin="6,0,0,0" Cursor="Hand" Click="btnCargarReservaEntrega_Click"/>
                        <Button x:Name="btnVerReservasPendientes" Grid.Column="2" Content="📋 Pendientes" Width="105" Height="35" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Margin="6,0,0,0" Cursor="Hand" ToolTip="Ver listado de reservas activas listas para entrega" Click="btnVerReservasPendientes_Click"/>

                        <!-- Popup de Reservas Pendientes -->
                        <Popup x:Name="popupReservasPendientes" PlacementTarget="{Binding ElementName=txtBuscarReservaEntrega}" 
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" 
                                    Padding="4" MaxHeight="240" Width="380">
                                <ListBox x:Name="lstReservasPendientes" Background="Transparent" BorderThickness="0" 
                                         SelectionMode="Single" SelectionChanged="lstReservasPendientes_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,5" Background="Transparent" CornerRadius="4">
                                                <DockPanel LastChildFill="True">
                                                    <Border DockPanel.Dock="Right" Background="#1E3A8A" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CodigoReserva, Mode=OneWay}" FontWeight="Bold" FontSize="10" Foreground="#60A5FA"/>
                                                    </Border>
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Cliente.NombreCompleto, Mode=OneWay}" FontWeight="Bold" Foreground="White" FontSize="12.5"/>
                                                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                                                            <Run Text="{Binding Vehiculo.MarcaModelo, Mode=OneWay}" Foreground="#38BDF8"/><Run Text=" ("/><Run Text="{Binding Vehiculo.Patente, Mode=OneWay}"/><Run Text=") • DNI: "/><Run Text="{Binding Cliente.Dni, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBlock x:Name="lblDetalleReservaEntrega" Text="Reserva: No seleccionada" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="INSPECCIÓN INICIAL" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <UniformGrid Columns="2" Margin="0,0,0,15">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Combustible (%)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtCombustibleSalida" Text="100" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Kilometraje Actual" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtKmSalida" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                        </StackPanel>
                    </UniformGrid>

                    <Button Content="Registrar Entrega de Llaves" Height="35" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnRegistrarEntrega_Click"/>
                </StackPanel>
            </Border>

            <!-- 2. REGISTRAR DEVOLUCIÓN Y DAÑOS -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="15" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="🔄 Registrar recepción y cierre (Check-in)" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                    <TextBlock Text="Buscar Alquiler (Código, Patente o Cliente)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtBuscarAlquilerDev" Grid.Column="0" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6" TextChanged="txtBuscarAlquilerDev_TextChanged"/>
                        <Button Grid.Column="1" Content="Cargar" Width="65" Height="35" Background="#334155" Foreground="White" BorderThickness="0" Margin="6,0,0,0" Cursor="Hand" Click="btnCargarAlquilerDev_Click"/>
                        <Button x:Name="btnVerAlquileresEnCurso" Grid.Column="2" Content="🚗 En Curso" Width="95" Height="35" Background="#059669" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Margin="6,0,0,0" Cursor="Hand" ToolTip="Ver listado de contratos en curso para recepción" Click="btnVerAlquileresEnCurso_Click"/>

                        <!-- Popup de Alquileres en Curso -->
                        <Popup x:Name="popupAlquileresEnCurso" PlacementTarget="{Binding ElementName=txtBuscarAlquilerDev}" 
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" 
                                    Padding="4" MaxHeight="240" Width="380">
                                <ListBox x:Name="lstAlquileresEnCurso" Background="Transparent" BorderThickness="0" 
                                         SelectionMode="Single" SelectionChanged="lstAlquileresEnCurso_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,5" Background="Transparent" CornerRadius="4">
                                                <DockPanel LastChildFill="True">
                                                    <Border DockPanel.Dock="Right" Background="#064E3B" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CodigoAlquiler, Mode=OneWay}" FontWeight="Bold" FontSize="10" Foreground="#34D399"/>
                                                    </Border>
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Reserva.Cliente.NombreCompleto, Mode=OneWay}" FontWeight="Bold" Foreground="White" FontSize="12.5"/>
                                                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                                                            <Run Text="{Binding Reserva.Vehiculo.MarcaModelo, Mode=OneWay}" Foreground="#38BDF8"/><Run Text=" ("/><Run Text="{Binding Reserva.Vehiculo.Patente, Mode=OneWay}"/><Run Text=") • Salida: "/><Run Text="{Binding FechaEntregaReal, StringFormat='dd/MM HH:mm', Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBlock x:Name="lblDetalleAlquilerDev" Text="Alquiler: No seleccionado" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Combustible Retorno (%)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtCombustibleEntrada" Text="100" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Kilometraje Retorno" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtKmEntrada" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Inspección de Daños y Novedades -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Inspección de Estado y Daños" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnInspeccionDanos" Content="📋 Inspección / Daños" Width="165" Height="34" 
                                    Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" 
                                    Click="btnInspeccionDanos_Click"/>

                            <TextBlock x:Name="lblFotoDanioStatus" Grid.Column="1" Text="✓ Sin novedades ni daños reportados" 
                                       Foreground="#10B981" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" 
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- Badge si se registró daño -->
                        <Border x:Name="bdrResumenDano" Visibility="Collapsed" Background="#450A0A" BorderBrush="#DC2626" 
                                BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="lblDanoRegistradoTitulo" Text="⚠️ Daño Reportado en Retorno:" FontWeight="Bold" FontSize="11" Foreground="#FCA5A5"/>
                                    <TextBlock x:Name="lblDanoRegistradoDetalle" Text="Paragolpes Delantero (Moderado)" FontSize="11" Foreground="#FECACA" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕ Quitar" Width="65" Height="24" Background="#7F1D1D" Foreground="#FCA5A5" 
                                        FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" 
                                        Click="btnQuitarDano_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Button Content="Finalizar Alquiler y Liberar Auto" Height="35" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnFinalizarAlquiler_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- HISTORIAL DE ALQUILERES -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra de búsqueda y título de historial -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Historial de contratos de alquiler" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    
                    <Grid HorizontalAlignment="Right" Width="320">
                        <TextBox x:Name="txtBuscarAlquiler" Height="32" Background="#0F172A" Foreground="White" 
                                 BorderBrush="#334155" Padding="8,5" TextChanged="txtBuscarAlquiler_TextChanged"/>
                        <TextBlock Text="🔍 Buscar contrato, cliente, patente..." Foreground="#64748B" IsHitTestVisible="False"
                                   Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Visibility>
                                <Binding Path="Text.IsEmpty" ElementName="txtBuscarAlquiler">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                </Grid>

                <DataGrid x:Name="dgvHistorial" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="Transparent" BorderThickness="0" RowHeight="42" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                          SelectionUnit="FullRow" Foreground="White">

                    <DataGrid.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A8A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A8A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A3A52"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoAlquiler}" Width="95" FontWeight="Bold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="16,0,0,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="Padding" Value="16,0,10,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding Reserva.Cliente.NombreCompleto}" Width="1.3*"/>
                        <DataGridTextColumn Header="VEHÍCULO" Binding="{Binding Reserva.Vehiculo.MarcaModelo}" Width="1.2*"/>
                        <DataGridTextColumn Header="PATENTE" Binding="{Binding Reserva.Vehiculo.Patente}" Width="95"/>
                        <DataGridTextColumn Header="ENTREGÓ" Binding="{Binding EmpleadoEntrega.NombreCompleto}" Width="1.2*"/>
                        <DataGridTextColumn Header="RECIBIÓ" Binding="{Binding EmpleadoDevolucion.NombreCompleto}" Width="1.2*"/>
                        <DataGridTextColumn Header="SALIDA" Binding="{Binding FechaEntregaReal, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="120"/>
                        <DataGridTextColumn Header="RETORNO" Binding="{Binding FechaEntregaDevolucion, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="120"/>
                        <DataGridTextColumn Header="KM RECORRIDOS" Binding="{Binding KmRecorridosTexto}" Width="105"/>
                        <DataGridTextColumn Header="MORA" Binding="{Binding MontoMora, StringFormat={}{0:C}}" Width="90"/>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding CostoTotalFinal, StringFormat={}{0:C}}" Width="100" FontWeight="Bold"/>

                        <!-- Daños e Inspección -->
                        <DataGridTemplateColumn Header="DAÑOS" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="⚠️ Ver" Height="24" Width="60"
                                            Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="Bold" FontSize="11"
                                            BorderThickness="0" Cursor="Hand" ToolTip="Ver detalle de inspección y evidencia fotográfica"
                                            Visibility="{Binding TieneDanos, Converter={StaticResource BoolToVisConverter}}"
                                            Click="btnVerDanos_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Factura PDF -->
                        <DataGridTemplateColumn Header="FACTURA" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="📄 Factura" Height="24" Width="75"
                                            Background="#1E3A8A" Foreground="#93C5FD" FontWeight="Bold" FontSize="11"
                                            BorderThickness="0" Cursor="Hand" ToolTip="Generar o descargar factura oficial en PDF"
                                            Click="btnGenerarFacturaFila_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>