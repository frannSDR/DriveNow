<UserControl x:Class="DriveNow.Views.TallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DriveNow.Converters"
             Background="#0F172A">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Encabezado y KPIs -->
            <RowDefinition Height="Auto"/>
            <!-- Barra de Filtros y Búsqueda -->
            <RowDefinition Height="*"/>
            <!-- Tabla Principal -->
        </Grid.RowDefinitions>

        <!-- 1. ENCABEZADO Y KPIS SUPERIORES -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <DockPanel LastChildFill="False" Margin="0,0,0,15">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="🔧 Centro de Taller y Mantenimiento de Flota" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Control técnico de unidades en reparación, siniestros y services preventivos periódicos." FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- BOTÓN PARA ENVIAR AUTO A SERVICE PREVENTIVO -->
                <Button x:Name="btnNuevoService" Content="➕ Ingresar a Service Preventivo" DockPanel.Dock="Right"
                        Height="38" Padding="16,0" Background="#2563EB" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="btnNuevoService_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>

            <!-- TARJETAS KPIS -->
            <UniformGrid Columns="4" Margin="0,0,0,5">
                <!-- KPI 1: En Taller Total -->
                <Border Background="#1E293B" CornerRadius="8" Padding="15,12" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="EN TALLER ACTIVO" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="lblKpiEnTaller" Text="0" FontSize="24" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                        <TextBlock Text="Unidades inmovilizadas" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Por Daño / Siniestro -->
                <Border Background="#1E293B" CornerRadius="8" Padding="15,12" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="POR SINIESTRO / DAÑO" FontSize="11" FontWeight="Bold" Foreground="#F87171"/>
                        <TextBlock x:Name="lblKpiDanos" Text="0" FontSize="24" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0"/>
                        <TextBlock Text="Derivados desde Check-in" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: En Service Preventivo -->
                <Border Background="#1E293B" CornerRadius="8" Padding="15,12" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SERVICE PREVENTIVO" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock x:Name="lblKpiPreventivo" Text="0" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                        <TextBlock Text="Mantenimiento periódico por km" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Liberados / Finalizados -->
                <Border Background="#1E293B" CornerRadius="8" Padding="15,12" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LIBERADOS A LA FLOTA" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                        <TextBlock x:Name="lblKpiFinalizados" Text="0" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                        <TextBlock Text="Reparaciones concluidas" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- 2. BARRA DE FILTROS Y BÚSQUEDA -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Vista:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <ComboBox x:Name="cmbFiltroEstado" Width="180" Height="34" SelectionChanged="cmbFiltroEstado_SelectionChanged">
                        <ComboBoxItem Content="En Taller (Activos)" IsSelected="True"/>
                        <ComboBoxItem Content="Historial Finalizado"/>
                        <ComboBoxItem Content="Todos los Registros"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" Foreground="#64748B" FontSize="14" VerticalAlignment="Center" Margin="5,0,8,0"/>
                    <TextBox x:Name="txtBusquedaTaller" Width="300" Height="34" 
                             Background="#0F172A" Foreground="White" BorderBrush="#334155" 
                             Padding="10,6" TextChanged="txtBusquedaTaller_TextChanged"/>
                    <TextBlock Text="Buscar por vehículo, patente, tipo o diagnóstico..." 
                               IsHitTestVisible="False" Foreground="#64748B" Margin="-290,0,0,0" 
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtBusquedaTaller}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. TABLA PRINCIPAL DE MANTENIMIENTOS -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="dgvMantenimientos" AutoGenerateColumns="False" 
                      Background="Transparent" BorderThickness="0"
                      RowBackground="#1E293B" AlternatingRowBackground="#182234"
                      Foreground="White" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#334155" HeadersVisibility="Column"
                      CanUserAddRows="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Padding" Value="0,4"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- VEHÍCULO -->
                    <DataGridTemplateColumn Header="VEHÍCULO" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="8,4">
                                    <TextBlock Text="{Binding Vehiculo.MarcaModelo}" FontWeight="Bold" Foreground="White" FontSize="12.5"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Border Background="#334155" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Vehiculo.Patente}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </Border>
                                        <TextBlock Text="{Binding Vehiculo.Categoria.Nombre}" FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- TIPO / ORIGEN -->
                    <DataGridTemplateColumn Header="TIPO / ORIGEN" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#3B250B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tipo}" Value="Siniestro / Reparación de Daño">
                                                    <Setter Property="Background" Value="#450A0A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Tipo}" FontWeight="Bold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tipo}" Value="Siniestro / Reparación de Daño">
                                                        <Setter Property="Foreground" Value="#F87171"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- MOTIVO Y DIAGNÓSTICO -->
                    <DataGridTemplateColumn Header="MOTIVO Y TRABAJO TÉCNICO" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="8,4">
                                    <TextBlock Text="{Binding Motivo}" Foreground="#E2E8F0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Diagnostico, TargetNullValue='Pendiente de diagnóstico técnico'}" 
                                               Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding TrabajoRealizado, TargetNullValue=''}" 
                                               Foreground="#34D399" FontSize="10.5" FontStyle="Italic" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- FECHA INGRESO -->
                    <DataGridTemplateColumn Header="INGRESO / DURACIÓN" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="8,4">
                                    <TextBlock Text="{Binding FechaIngreso, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="#CBD5E1" FontSize="11.5"/>
                                    <TextBlock Text="{Binding DuracionTexto, StringFormat='Tiempo: {0}'}" Foreground="#94A3B8" FontSize="10.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ESTADO -->
                    <DataGridTemplateColumn Header="ESTADO" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#451A03"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Estado}" Value="Finalizado">
                                                    <Setter Property="Background" Value="#064E3B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Estado}" FontWeight="Bold" FontSize="10.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Estado}" Value="Finalizado">
                                                        <Setter Property="Foreground" Value="#34D399"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COSTO -->
                    <DataGridTextColumn Header="COSTO ($)" Binding="{Binding Costo, StringFormat='${0:N2}'}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#34D399"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ACCIONES -->
                    <DataGridTemplateColumn Header="ACCIONES" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Botón Editar Diagnóstico / Trabajo -->
                                    <Button Content="🔧 Trabajos" Height="28" Padding="8,2" Margin="0,0,6,0"
                                            Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1"
                                            Cursor="Hand" ToolTip="Registrar diagnóstico, tareas o repuestos"
                                            Click="btnEditarTrabajo_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- Botón Liberar a la Flota -->
                                    <Button Content="✅ Liberar" Height="28" Padding="8,2"
                                            Background="#059669" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                            Cursor="Hand" ToolTip="Finalizar orden y devolver vehículo a Disponible"
                                            Click="btnLiberarVehiculo_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Estado}" Value="Finalizado">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. MODAL: INGRESAR A SERVICE PREVENTIVO -->
        <Grid x:Name="modalServiceOverlay" Grid.RowSpan="3" Background="#B00F172A" Visibility="Collapsed">
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Background="#1E293B" CornerRadius="12" Padding="24" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,18">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="🛠️ Programar Service Preventivo" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Ingresar un vehículo a mantenimiento técnico periódico" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                        <Button Content="✕" Background="Transparent" Foreground="#94A3B8" FontSize="16"
                                BorderThickness="0" Cursor="Hand" DockPanel.Dock="Right"
                                Click="btnCerrarModalService_Click"/>
                    </DockPanel>

                    <!-- Selector de Vehículo -->
                    <TextBlock Text="Vehículo a ingresar (Disponibles):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cmbVehiculosService" Height="36" Margin="0,0,0,14" 
                              DisplayMemberPath="DescripcionCompleta" SelectedValuePath="IdVehiculo"/>

                    <!-- Tipo de Service -->
                    <TextBlock Text="Tipo de Mantenimiento Preventivo:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cmbTipoService" Height="36" Margin="0,0,0,14">
                        <ComboBoxItem Content="Service 10.000 Km (Aceite sintético, filtros aire/aceite)" IsSelected="True"/>
                        <ComboBoxItem Content="Service 20.000 Km (Frenos, pastillas, bujías y fluidos)"/>
                        <ComboBoxItem Content="Revisión de Neumáticos, Alineación y Balanceo"/>
                        <ComboBoxItem Content="Revisión de Suspensión y Tren Delantero"/>
                        <ComboBoxItem Content="Mantenimiento General / Inspección Preventiva"/>
                    </ComboBox>

                    <!-- Observaciones -->
                    <TextBlock Text="Motivo u Observaciones del Ingreso:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtObservacionesService" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                             Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,8" Margin="0,0,0,20"/>

                    <!-- Botones -->
                    <DockPanel LastChildFill="False">
                        <Button Content="Cancelar" Width="100" Height="36" Background="#334155" Foreground="White"
                                BorderThickness="0" Cursor="Hand" Click="btnCerrarModalService_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Confirmar Ingreso al Taller" DockPanel.Dock="Right" Height="36" Padding="16,0"
                                Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                Click="btnConfirmarIngresoService_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 5. MODAL: REGISTRAR DIAGNÓSTICO Y TRABAJO TÉCNICO -->
        <Grid x:Name="modalTrabajoOverlay" Grid.RowSpan="3" Background="#B00F172A" Visibility="Collapsed">
            <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Background="#1E293B" CornerRadius="12" Padding="24" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="📋 Orden de Trabajo y Diagnóstico Técnico" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="lblSubtituloVehiculoTrabajo" Text="Vehículo en reparación" FontSize="12" Foreground="#38BDF8"/>
                        </StackPanel>
                        <Button Content="✕" Background="Transparent" Foreground="#94A3B8" FontSize="16"
                                BorderThickness="0" Cursor="Hand" DockPanel.Dock="Right"
                                Click="btnCerrarModalTrabajo_Click"/>
                    </DockPanel>

                    <!-- Motivo Original -->
                    <Border Background="#0F172A" CornerRadius="6" Padding="12,8" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Motivo de Ingreso Asentado:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="lblMotivoIngresoModal" Text="Detalle del motivo..." FontSize="12" Foreground="#F59E0B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Diagnóstico Técnico -->
                    <TextBlock Text="Diagnóstico Técnico / Peritaje del Mecánico:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtDiagnosticoModal" Height="65" TextWrapping="Wrap" AcceptsReturn="True"
                             Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,8" Margin="0,0,0,12"/>

                    <!-- Tareas / Repuestos -->
                    <TextBlock Text="Trabajos Realizados y Repuestos Utilizados:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtTrabajoModal" Height="65" TextWrapping="Wrap" AcceptsReturn="True"
                             Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,8" Margin="0,0,0,12"/>

                    <!-- Costo -->
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Costo de Reparación / Insumos ($ ARS):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtCostoModal" Width="180" Height="34" HorizontalAlignment="Left"
                                 Background="#0F172A" Foreground="#34D399" FontWeight="Bold" BorderBrush="#334155" Padding="10,6"/>
                    </StackPanel>

                    <!-- Botones -->
                    <DockPanel LastChildFill="False">
                        <Button Content="Cancelar" Width="90" Height="36" Background="#334155" Foreground="White"
                                BorderThickness="0" Cursor="Hand" Click="btnCerrarModalTrabajo_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="💾 Guardar Cambios" DockPanel.Dock="Right" Height="36" Padding="16,0"
                                Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                Click="btnGuardarTrabajo_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
