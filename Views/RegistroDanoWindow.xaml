<Window x:Class="DriveNow.Views.RegistroDanoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drive Now - Reporte de Inspección y Daños"
        Height="640" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="🛠️ Inspección de Retorno y Reporte de Daños" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="lblSubtituloVehiculo" Text="Vehículo: -" FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- FORMULARIO DE INSPECCIÓN -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Zona Afectada y Nivel de Gravedad -->
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Sector / Pieza Afectada" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbSector" Height="35"/>
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Nivel de Gravedad" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbGravedad" Height="35"
                                      SelectionChanged="cmbGravedad_SelectionChanged"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Descripción Detallada -->
                    <TextBlock Text="Descripción Técnica del Daño" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtDescripcion" Height="70" Background="#0F172A" Foreground="White" BorderBrush="#334155" 
                             Padding="8,6" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>

                    <!-- Decisión Operativa del Vehículo -->
                    <Border Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="chkInmovilizar" Content="⚠️ Inmovilizar vehículo y derivar a 'En Taller'" 
                                      Foreground="#FCA5A5" FontWeight="Bold" FontSize="12.5" IsChecked="True"/>
                            <TextBlock Text="Si se desmarca, el daño quedará registrado pero el vehículo volverá a estado 'Disponible' para alquiler (recomendado para rayones o roces menores)." 
                                       Foreground="#64748B" FontSize="11" Margin="22,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Evidencia Fotográfica -->
                    <TextBlock Text="Evidencia Fotográfica" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <Button x:Name="btnSeleccionarFoto" Content="📷 Seleccionar Fotografía" Width="180" Height="32" 
                                Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" 
                                DockPanel.Dock="Left" Click="btnSeleccionarFoto_Click"/>
                        <TextBlock x:Name="lblFotoStatus" Text="Ninguna foto seleccionada" Foreground="#94A3B8" FontSize="11.5" 
                                   VerticalAlignment="Center" Margin="10,0,0,0" DockPanel.Dock="Left" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                    </DockPanel>

                    <!-- Vista Previa de la Fotografía -->
                    <Border x:Name="pnlVistaPrevia" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" 
                            Height="140" Margin="0,0,0,6" Visibility="Collapsed">
                        <Image x:Name="imgPrevia" Stretch="Uniform" Margin="4"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- BOTONES DE ACCIÓN -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar" Width="100" Height="36" Background="#475569" Foreground="White" 
                    BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="btnCancelar_Click"/>
            <Button Content="Confirmar Daño" Width="140" Height="36" Background="#EF4444" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnConfirmar_Click"/>
        </StackPanel>
    </Grid>
</Window>
