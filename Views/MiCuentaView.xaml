<UserControl x:Class="DriveNow.Views.MiCuentaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Configuración de Cuenta y Seguridad" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Administra tus datos de perfil y credenciales de acceso al sistema." FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- CUERPO PRINCIPAL (2 COLUMNAS) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMNA 1: FICHA DE PERFIL -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="20" Margin="0,0,10,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="👤 Datos del Perfil" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                    <!-- Avatar / Iniciales -->
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" Width="70" Height="70" CornerRadius="35" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <TextBlock x:Name="lblInicialesAvatar" Text="DN" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Nombre Completo -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="NOMBRE COMPLETO" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="lblNombreCompleto" Text="Cargando..." Foreground="White" FontSize="15" FontWeight="Medium" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- DNI -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="DOCUMENTO (DNI)" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="lblDni" Text="-" Foreground="White" FontSize="15" FontWeight="Medium" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Correo -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="CORREO ELECTRÓNICO" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="lblEmail" Text="-" Foreground="White" FontSize="15" FontWeight="Medium" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Rol Asignado -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="NIVEL DE ACCESO" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        <Border Background="#0F172A" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,6,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="lblRolBadge" Text="ROL" Foreground="#38BDF8" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- COLUMNA 2: CAMBIO DE CONTRASEÑA -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="20" Margin="10,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="🔒 Actualizar Contraseña" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="Por seguridad, tu nueva clave debe tener al menos 6 caracteres." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,20"/>

                    <!-- Clave Actual -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Contraseña Actual" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="txtPassActual" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,6"/>
                    </StackPanel>

                    <!-- Clave Nueva -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Nueva Contraseña" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="txtPassNueva" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,6"/>
                    </StackPanel>

                    <!-- Confirmar Clave Nueva -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Confirmar Nueva Contraseña" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="txtPassConfirmar" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10,6"/>
                    </StackPanel>

                    <!-- Botones -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Limpiar" Width="100" Height="36" Background="#334155" Foreground="White" 
                                BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="btnLimpiarPass_Click"/>
                        <Button Content="Guardar Contraseña" Width="160" Height="36" Background="#2563EB" Foreground="White" 
                                FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnActualizarPass_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>