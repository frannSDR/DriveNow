<UserControl x:Class="DriveNow.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#0F172A">

    <UserControl.Resources>
        <Style x:Key="SegmentedTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Encabezado y Filtros -->
            <RowDefinition Height="Auto"/>
            <!-- KPIs Financieros -->
            <RowDefinition Height="*"/>
            <!-- Vistas: Gráficos Estadísticos / Auditoría Detallada -->
        </Grid.RowDefinitions>

        <!-- ENCABEZADO Y FILTROS TEMPORALES -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Reportes y Análisis Estadístico" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Consolidado de facturación, dinámicas temporales, distribución de flota e inferencia estadística." FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Selector de Período y Exportación -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Desde:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="dpDesde" Width="130" Height="32" SelectedDateChanged="FiltroFechas_Changed"/>

                    <TextBlock Text="Hasta:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <DatePicker x:Name="dpHasta" Width="130" Height="32" SelectedDateChanged="FiltroFechas_Changed"/>

                    <Button Content="Filtrar" Width="80" Height="32" Background="#2563EB" Foreground="White" 
                            FontWeight="SemiBold" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand" Click="btnFiltrar_Click"/>

                    <Button x:Name="btnExportarCsv" Content="📥 Exportar CSV" Width="125" Height="32" Background="#059669" Foreground="White" 
                            FontWeight="SemiBold" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand" Click="btnExportarCsv_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- TARJETAS DE KPIS FINANCIEROS -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <!-- Ingresos Totales -->
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="15" Margin="4">
                <StackPanel>
                    <TextBlock Text="💵 FACTURACIÓN TOTAL" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="lblIngresosTotales" Text="$0.00" FontSize="22" FontWeight="Bold" Foreground="#4ADE80" Margin="0,6,0,0"/>
                    <TextBlock Text="Base + Moras cobradas" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Ingresos por Alquiler Base -->
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="15" Margin="4">
                <StackPanel>
                    <TextBlock Text="🚗 INGRESOS POR TARIFA" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="lblIngresosBase" Text="$0.00" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,6,0,0"/>
                    <TextBlock Text="Contratos en regla" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Penalizaciones y Moras -->
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="15" Margin="4">
                <StackPanel>
                    <TextBlock Text="⚠️ RECARGOS POR MORA" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="lblIngresosMora" Text="$0.00" FontSize="22" FontWeight="Bold" Foreground="#F87171" Margin="0,6,0,0"/>
                    <TextBlock Text="Penalizaciones aplicadas" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Ticket Promedio -->
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="15" Margin="4">
                <StackPanel>
                    <TextBlock Text="📈 TICKET PROMEDIO" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="lblTicketPromedio" Text="$0.00" FontSize="22" FontWeight="Bold" Foreground="#FBBF24" Margin="0,6,0,0"/>
                    <TextBlock x:Name="lblTotalContratos" Text="0 contratos cerrados" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- SECCIÓN PRINCIPAL: SELECTOR DE VISTAS (GRÁFICOS vs AUDITORÍA) -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Switcher Segmentado de Pestañas -->
            <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,12" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rbVistaGraficos" Content="📊 Gráficos y Probabilidades" IsChecked="True" 
                                 Checked="TabVista_Checked" Style="{StaticResource SegmentedTabButtonStyle}"/>
                    <RadioButton x:Name="rbVistaTablas" Content="📋 Auditoría y Detalle de Contratos" 
                                 Checked="TabVista_Checked" Style="{StaticResource SegmentedTabButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- PESTAÑA 1: VISTA DE GRÁFICOS Y ANÁLISIS ESTADÍSTICO -->
            <ScrollViewer x:Name="pnlGraficos" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,5,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="290"/>
                        <RowDefinition Height="290"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. GRÁFICO DE LÍNEAS / ÁREA: EVOLUCIÓN TEMPORAL DE INGRESOS -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,6,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="📈 Dinámica Diaria de Facturación ($)" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Serie temporal de ingresos diarios (base + recargos por mora)" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                            <lvc:CartesianChart x:Name="chartEvolucion" Grid.Row="1" Background="Transparent" LegendPosition="Hidden"/>
                        </Grid>
                    </Border>

                    <!-- 2. GRÁFICO DE DONA: ESTADO Y DISPONIBILIDAD DE LA FLOTA -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="15" Margin="6,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="🍩 Estado de la Flota (Distribución Empírica)" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Frecuencia relativa y probabilidad empírica de estados operativos" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                            <lvc:PieChart x:Name="chartFlota" Grid.Row="1" Background="Transparent" LegendPosition="Right"/>
                        </Grid>
                    </Border>

                    <!-- 3. GRÁFICO DE BARRAS: DEMANDA Y FACTURACIÓN POR CATEGORÍA -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,6,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="📊 Rendimiento por Categoría (Frecuencia y Facturación)" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Distribución de contratos cerrados (verde) y facturación acumulada (azul)" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                            <lvc:CartesianChart x:Name="chartCategorias" Grid.Row="1" Background="Transparent" LegendPosition="Top"/>
                        </Grid>
                    </Border>

                    <!-- 4. PANEL DE INDICADORES ESTADÍSTICOS Y RIESGO OPERATIVO -->
                    <Border Grid.Row="1" Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="15" Margin="6,6,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="📐 Indicadores Estadísticos &amp; Riesgo" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Probabilidad y estadística aplicada a la operación del negocio" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>

                            <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                                <!-- Indicador 1: P(Mora) -->
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="PROBABILIDAD DE MORA P(M)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="lblProbMora" Text="0.0%" FontSize="20" FontWeight="Bold" Foreground="#F87171" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="lblDetalleMora" Text="0 de 0 contratos" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Indicador 2: P(Daño | Retorno) -->
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="RIESGO DE DAÑOS P(D|R)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="lblProbDanos" Text="0.0%" FontSize="20" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="lblDetalleDanos" Text="0 contratos siniestrados" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Indicador 3: Duración Media (x̄) -->
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="DURACIÓN MEDIA (x̄)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="lblMediaDias" Text="0.0 días" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="lblDesvioDias" Text="Desv. estándar s = 0.0" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Indicador 4: Categoría Modal (Mo) -->
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="CATEGORÍA MODAL (Mo)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="lblModaCategoria" Text="N/D" FontSize="17" FontWeight="Bold" Foreground="#4ADE80" Margin="0,4,0,2" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="lblDetalleModa" Text="Mayor frecuencia observada" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- PESTAÑA 2: VISTA DE AUDITORÍA Y TABLAS COMPARATIVAS -->
            <Grid x:Name="pnlTablas" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Rendimiento por Categoría -->
                <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Rendimiento por Categoría" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                        <DataGrid x:Name="dgvRendimientoCat" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="Transparent" BorderThickness="0" RowHeight="38" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                                  SelectionUnit="FullRow" Foreground="White">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A8A"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Categoria}" Width="1.2*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="ALQUILERES" Binding="{Binding CantidadAlquileres}" Width="85"/>
                                <DataGridTextColumn Header="FACTURACIÓN" Binding="{Binding TotalRecaudado, StringFormat={}{0:C}}" Width="1.3*" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 2. Detalle de Contratos Liquidados -->
                <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="15" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Contratos Liquidados en el Período" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                        <DataGrid x:Name="dgvContratosCerrados" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="Transparent" BorderThickness="0" RowHeight="38" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                                  SelectionUnit="FullRow" Foreground="White">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A8A"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CONTRATO" Binding="{Binding CodigoAlquiler}" Width="85" FontWeight="Bold"/>
                                <DataGridTextColumn Header="CLIENTE" Binding="{Binding Cliente}" Width="1.1*"/>
                                <DataGridTextColumn Header="VEHÍCULO" Binding="{Binding Vehiculo}" Width="1*"/>
                                <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Categoria}" Width="90"/>
                                <DataGridTextColumn Header="DÍAS" Binding="{Binding DiasReales, StringFormat={}{0:F0} d}" Width="55"/>
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding EstadoRetorno}" Width="95"/>
                                <DataGridTextColumn Header="TARIFA" Binding="{Binding CostoBase, StringFormat={}{0:C}}" Width="90"/>
                                <DataGridTextColumn Header="MORA" Binding="{Binding MontoMora, StringFormat={}{0:C}}" Width="85"/>
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalCobrado, StringFormat={}{0:C}}" Width="100" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>