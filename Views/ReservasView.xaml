<UserControl x:Class="DriveNow.Views.ReservasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Encabezado y Acción Principal -->
            <RowDefinition Height="Auto"/>
            <!-- Tablero de Disponibilidad por Categoría -->
            <RowDefinition Height="*"/>
            <!-- Tabla de Reservas -->
        </Grid.RowDefinitions>

        <!-- 1. ENCABEZADO SUPERIOR Y BOTÓN DE ACCIÓN -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Gestión de reservas" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Administra el flujo de reservas, disponibilidad por categoría y presupuestos." FontSize="13" Foreground="#94A3B8"/>
            </StackPanel>

            <Button x:Name="btnNuevaReserva" Content="➕ Nueva Reserva" DockPanel.Dock="Right"
                    Height="40" Padding="18,0" Background="#2563EB" Foreground="White" 
                    FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand"
                    Click="btnNuevaReserva_Click"/>
        </DockPanel>

        <!-- 2. TABLERO DE DISPONIBILIDAD AMPLIADO Y MÓDULO VISUAL -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tarjeta Principal KPI Ocupación Total -->
                <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,15,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📊 OCUPACIÓN" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblPorcentajeOcupacion" Text="0%" FontSize="32" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text="Flota Total" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Grid de Tarjetas de Disponibilidad por Categoría -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="DISPONIBILIDAD POR CATEGORÍA" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10"/>

                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="icCategoriasOcupacion">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" CornerRadius="6" Padding="12,10" Margin="0,0,10,6" Width="185" BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Nombre}" FontWeight="Bold" Foreground="White" FontSize="12" DockPanel.Dock="Left" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                                <TextBlock Text="{Binding RatioTexto}" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" DockPanel.Dock="Right"/>
                                            </DockPanel>

                                            <ProgressBar Height="6" Value="{Binding Porcentaje}" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. TABLA DE RESERVAS REGISTRADAS -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Listado de reservas" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

                    <Grid HorizontalAlignment="Right" Width="320">
                        <TextBox x:Name="txtBuscarReserva" Height="32" Background="#0F172A" Foreground="White" 
                                 BorderBrush="#334155" Padding="8,5" TextChanged="txtBuscarReserva_TextChanged"/>
                        <TextBlock Text="🔍 Buscar código, cliente, patente..." Foreground="#64748B" IsHitTestVisible="False"
                                   Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Visibility>
                                <Binding Path="Text.IsEmpty" ElementName="txtBuscarReserva">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                </Grid>

                <DataGrid x:Name="dgvReservas" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="Transparent" BorderThickness="0" RowHeight="42" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                          SelectionUnit="FullRow" Foreground="White">

                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A8A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A8A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A3A52"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoReserva}" Width="100" FontWeight="Bold"/>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding Cliente.NombreCompleto}" Width="1.4*"/>
                        <DataGridTextColumn Header="OPERADOR" Binding="{Binding Empleado.NombreCompleto}" Width="1.2*"/>
                        <DataGridTextColumn Header="VEHÍCULO" Binding="{Binding Vehiculo.MarcaModelo}" Width="1.3*"/>
                        <DataGridTextColumn Header="PATENTE" Binding="{Binding Vehiculo.Patente}" Width="100"/>
                        <DataGridTextColumn Header="DESDE" Binding="{Binding FechaDesde, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="HASTA" Binding="{Binding FechaHasta, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado.Nombre}" Width="110"/>

                        <DataGridTemplateColumn x:Name="colAccionesReserva" Header="ACCIONES" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="❌" ToolTip="Cancelar Reserva" Background="Transparent" Foreground="#F87171" 
                                            BorderThickness="0" Cursor="Hand" Click="btnCancelarReservaFila_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- CAPA SUPERPUESTA MODAL (OVERLAY) PARA CREAR RESERVA -->
        <Grid x:Name="modalOverlay" Grid.RowSpan="3" Background="#B00F172A" Visibility="Collapsed">
            <Border Width="650" HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Background="#1E293B" CornerRadius="12" Padding="22" BorderBrush="#334155" BorderThickness="1">
                <StackPanel x:Name="pnlFormularioReserva">
                    <DockPanel LastChildFill="False" Margin="0,0,0,15">
                        <TextBlock Text="📝 Crear nueva reserva" FontSize="18" FontWeight="Bold" Foreground="White" DockPanel.Dock="Left"/>
                        <Button Content="❌" Background="Transparent" Foreground="#94A3B8" FontSize="14"
                                BorderThickness="0" Cursor="Hand" DockPanel.Dock="Right"
                                Click="btnCerrarModal_Click"/>
                    </DockPanel>

                    <TextBlock Text="Conductor / Cliente Titular *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>

                    <!-- Buscador Predictivo -->
                    <Grid x:Name="pnlBuscadorCliente" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <TextBox x:Name="txtBuscarClienteReserva" Height="35" Background="#0F172A" Foreground="White" 
                                         BorderBrush="#334155" Padding="8,6" TextChanged="txtBuscarClienteReserva_TextChanged"/>
                                <TextBlock Text="🔍 Buscar por apellido, nombre o DNI..." Foreground="#64748B" IsHitTestVisible="False"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Visibility>
                                        <Binding Path="Text.IsEmpty" ElementName="txtBuscarClienteReserva">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </Grid>

                            <Button x:Name="btnVerPadronClientes" Grid.Column="1" Content="👥 Padrón" Width="85" Height="35" 
                                    Background="#334155" Foreground="White" BorderThickness="0" Margin="8,0,0,0" 
                                    Cursor="Hand" ToolTip="Ver listado de clientes activos" Click="btnVerPadronClientes_Click"/>
                        </Grid>

                        <Popup x:Name="popupSugerenciasClientes" PlacementTarget="{Binding ElementName=txtBuscarClienteReserva}" 
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" 
                                    Padding="4" MaxHeight="220" Width="380">
                                <ListBox x:Name="lstSugerenciasClientes" Background="Transparent" BorderThickness="0" 
                                         SelectionMode="Single" SelectionChanged="lstSugerenciasClientes_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,5" Background="Transparent" CornerRadius="4">
                                                <DockPanel LastChildFill="True">
                                                    <Border DockPanel.Dock="Right" Background="#065F46" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding EstadoLicencia}" FontWeight="Bold" FontSize="9" Foreground="#34D399"/>
                                                    </Border>
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding NombreCompleto}" FontWeight="Bold" Foreground="White" FontSize="12.5"/>
                                                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                                                            <Run Text="DNI: "/><Run Text="{Binding Dni, Mode=OneWay}"/><Run Text=" • "/><Run Text="Licencia: "/><Run Text="{Binding NroLicencia, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Tarjeta de Cliente Seleccionado -->
                    <Border x:Name="pnlClienteSeleccionado" Background="#0F172A" BorderBrush="#2563EB" BorderThickness="1" 
                            CornerRadius="6" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="btnCambiarCliente" Content="✕ Cambiar" Width="85" Height="28" 
                                    Background="#334155" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="11"
                                    BorderThickness="0" Cursor="Hand" DockPanel.Dock="Right" Click="btnCambiarCliente_Click"/>

                            <StackPanel Margin="0,0,8,0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock x:Name="lblClienteSeleccionadoNombre" Text="👤 Nombre Cliente" FontWeight="Bold" Foreground="White" FontSize="13" DockPanel.Dock="Left"/>
                                    <Border Background="#065F46" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                                        <TextBlock Text="VALIDADO" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                                    </Border>
                                </DockPanel>
                                <TextBlock x:Name="lblClienteSeleccionadoInfo" Text="DNI: 12345678 | Licencia: VIGENTE" FontSize="11" Foreground="#38BDF8" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Fechas -->
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Fecha de Retiro *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <DatePicker x:Name="dpFechaInicio" Height="35" SelectedDateChanged="dpFechas_SelectedDateChanged"/>
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Fecha de Devolución *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <DatePicker x:Name="dpFechaFin" Height="35" SelectedDateChanged="dpFechas_SelectedDateChanged"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Filtros y Selección de Vehículo -->
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Filtrar Categoría" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbCategoriaReserva" Height="35"
                                      DisplayMemberPath="Nombre" SelectedValuePath="IdCategoria"
                                      SelectionChanged="cmbCategoriaReserva_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Vehículo Disponible *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbVehiculosDisponibles" Height="35"
                                      DisplayMemberPath="TextoMostrar" SelectedValuePath="IdVehiculo"
                                      SelectionChanged="cmbVehiculosDisponibles_SelectionChanged"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Presupuesto Estimado -->
                    <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,18" BorderBrush="#334155" BorderThickness="1">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock x:Name="lblDuracionDias" Text="Duración: 0 días" Foreground="#94A3B8" FontSize="12"/>
                                <TextBlock x:Name="lblTarifaAplicada" Text="Tarifa por día: $0.00" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL ESTIMADO" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="lblTotalPresupuesto" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Width="100" Height="35" Background="#475569" Foreground="White" 
                                BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="btnCerrarModal_Click"/>
                        <Button Content="Confirmar Reserva" Width="150" Height="35" Background="#2563EB" Foreground="White" 
                                FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnConfirmarReserva_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>