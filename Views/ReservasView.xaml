<UserControl x:Class="DriveNow.Views.ReservasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Gestión de reservas" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Administra el flujo de reservas, disponibilidad y cálculo de presupuestos." FontSize="13" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- BLOQUE SUPERIOR -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- FORMULARIO CREAR RESERVA -->
            <Border x:Name="pnlFormularioReserva" Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="📝 Crear nueva reserva" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                    <TextBlock Text="Cliente (DNI)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtDniCliente" Grid.Column="0" Height="35" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                        <Button x:Name="btnBuscarClienteReserva" Grid.Column="1" Content="Validar" Width="75" Height="35" 
                                Background="#334155" Foreground="White" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand" Click="btnBuscarClienteReserva_Click"/>
                    </Grid>
                    <TextBlock x:Name="lblClienteSeleccionado" Text="Cliente: No seleccionado" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,10"/>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Fecha de Retiro" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <DatePicker x:Name="dpFechaInicio" Height="35" SelectedDateChanged="dpFechas_SelectedDateChanged"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Fecha de Devolución" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <DatePicker x:Name="dpFechaFin" Height="35" SelectedDateChanged="dpFechas_SelectedDateChanged"/>
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Filtrar Categoría" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbCategoriaReserva" Height="35" Background="#0F172A" Foreground="Black" Padding="8,6"
                                      DisplayMemberPath="Nombre" SelectedValuePath="IdCategoria"
                                      SelectionChanged="cmbCategoriaReserva_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Vehículo Disponible" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbVehiculosDisponibles" Height="35" Background="#0F172A" Foreground="Black" Padding="8,6"
                                      DisplayMemberPath="TextoMostrar" SelectedValuePath="IdVehiculo"
                                      SelectionChanged="cmbVehiculosDisponibles_SelectionChanged"/>
                        </StackPanel>
                    </UniformGrid>

                    <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock x:Name="lblDuracionDias" Text="Duración: 0 días" Foreground="#94A3B8" FontSize="12"/>
                                <TextBlock x:Name="lblTarifaAplicada" Text="Tarifa por día: $0.00" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL ESTIMADO" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="lblTotalPresupuesto" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Limpiar" Width="90" Height="35" Background="#334155" Foreground="White" 
                                BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="btnCancelarReserva_Click"/>
                        <Button Content="Confirmar Reserva" Width="145" Height="35" Background="#2563EB" Foreground="White" 
                                FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnConfirmarReserva_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- TABLERO DE DISPONIBILIDAD -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="15" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="📊 Tablero de disponibilidad" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                    <Border Background="#0F172A" CornerRadius="8" Padding="15" Margin="0,0,0,15" HorizontalAlignment="Center" Width="140">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="lblPorcentajeOcupacion" Text="0%" FontSize="28" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ocupación Flota" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Disponibilidad por Categoría" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,10"/>

                    <ItemsControl x:Name="icCategoriasOcupacion">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{Binding Nombre}" Foreground="White" FontSize="12" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding RatioTexto}" Foreground="#38BDF8" FontSize="12" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar Height="6" Value="{Binding Porcentaje}" Foreground="#38BDF8" Background="#0F172A" BorderThickness="0" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- TABLA DE RESERVAS REGISTRADAS -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra de búsqueda y título de reservas -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Reservas registradas" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    
                    <Grid HorizontalAlignment="Right" Width="320">
                        <TextBox x:Name="txtBuscarReserva" Height="32" Background="#0F172A" Foreground="White" 
                                 BorderBrush="#334155" Padding="8,5" TextChanged="txtBuscarReserva_TextChanged"/>
                        <TextBlock Text="🔍 Buscar código, cliente, patente..." Foreground="#64748B" IsHitTestVisible="False"
                                   Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Visibility>
                                <Binding Path="Text.IsEmpty" ElementName="txtBuscarReserva">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                </Grid>

                <DataGrid x:Name="dgvReservas" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="Transparent" BorderThickness="0" RowHeight="42" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                          SelectionUnit="FullRow" Foreground="White">

                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A8A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A8A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A3A52"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoReserva}" Width="100" FontWeight="Bold"/>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding Cliente.NombreCompleto}" Width="1.4*"/>
                        <DataGridTextColumn Header="OPERADOR" Binding="{Binding Empleado.NombreCompleto}" Width="1.2*"/>
                        <DataGridTextColumn Header="VEHÍCULO" Binding="{Binding Vehiculo.MarcaModelo}" Width="1.3*"/>
                        <DataGridTextColumn Header="PATENTE" Binding="{Binding Vehiculo.Patente}" Width="100"/>
                        <DataGridTextColumn Header="DESDE" Binding="{Binding FechaDesde, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="HASTA" Binding="{Binding FechaHasta, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado.Nombre}" Width="110"/>

                        <!-- Cancelar Reserva -->
                        <DataGridTemplateColumn x:Name="colAccionesReserva" Header="ACCIONES" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="❌" ToolTip="Cancelar Reserva" Background="Transparent" Foreground="#F87171" 
                                            BorderThickness="0" Cursor="Hand" Click="btnCancelarReservaFila_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>