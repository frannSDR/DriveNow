<UserControl x:Class="DriveNow.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Panel Principal" FontSize="26" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Resumen del estado operativo de la flota" FontSize="14" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- Tarjetas de Resumen (KPIs) -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">

            <!-- Tarjeta 1: Vehículos en Flota -->
            <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="5">
                <StackPanel>
                    <TextBlock Text="🚗 VEHÍCULOS EN FLOTA" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="35" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,5"/>
                    <TextBlock Text="4 categorías activas" FontSize="11" Foreground="#38BDF8"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 2: Disponibles -->
            <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="5">
                <StackPanel>
                    <TextBlock Text="✅ DISPONIBLES AHORA" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="18" FontSize="28" FontWeight="Bold" Foreground="#4ADE80" Margin="0,5"/>
                    <TextBlock Text="51% de ocupación" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 3: Alquileres Activos -->
            <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="5">
                <StackPanel>
                    <TextBlock Text="🔑 ALQUILERES ACTIVOS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="12" FontSize="28" FontWeight="Bold" Foreground="#FBBF24" Margin="0,5"/>
                    <TextBlock Text="2 con mora" FontSize="11" Foreground="#F87171"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 4: En Mantenimiento -->
            <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="5">
                <StackPanel>
                    <TextBlock Text="🔧 EN MANTENIMIENTO" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="5" FontSize="28" FontWeight="Bold" Foreground="#F87171" Margin="0,5"/>
                    <TextBlock Text="En revisión técnica" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Área de Contenido Inferior -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="20">
            <TextBlock Text="Sección de Gráficos y Actividad Reciente (En Construcción)" 
                       Foreground="#64748B" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>