<UserControl x:Class="DriveNow.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Bienvenida y Perfil -->
            <RowDefinition Height="Auto"/>
            <!-- Tarjetas KPIs Principales -->
            <RowDefinition Height="*"/>
            <!-- Alertas Operativas y Últimas Operaciones -->
        </Grid.RowDefinitions>

        <!-- ENCABEZADO DE BIENVENIDA -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="20,16" Margin="0,0,0,15">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="lblBienvenida" Text="Bienvenido de nuevo" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="lblSubtituloRol" Text="Resumen de actividad y estado operativo en tiempo real." FontSize="13" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Right" Background="#0F172A" CornerRadius="6" Padding="12,8" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📅" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblFechaActual" Text="Hoy" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- TARJETAS DE KPIS PRINCIPALES -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
            <!-- 1. Vehículos Disponibles -->
            <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="🚗 FLOTA DISPONIBLE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="lblKpiDisponibles" Text="0" FontSize="24" FontWeight="Bold" Foreground="#4ADE80" Margin="0,6,0,0"/>
                    <TextBlock x:Name="lblKpiTotalFlota" Text="0 vehículos en flota" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 2. Alquileres en Curso -->
            <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="🔑 ALQUILERES ACTIVOS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="lblKpiAlquileresActivos" Text="0" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" Margin="0,6,0,0"/>
                    <TextBlock Text="Vehículos en calle" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 3. Reservas Próximas -->
            <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="📅 RESERVAS CONFIRMADAS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="lblKpiReservasConfirmadas" Text="0" FontSize="24" FontWeight="Bold" Foreground="#FBBF24" Margin="0,6,0,0"/>
                    <TextBlock Text="Pendientes de entrega" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 4. Facturación del Mes -->
            <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="💵 FACTURACIÓN DEL MES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="lblKpiFacturacionMes" Text="$0.00" FontSize="22" FontWeight="Bold" Foreground="#A78BFA" Margin="0,6,0,0"/>
                    <TextBlock Text="Total cobrado en curso" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- SECCIÓN DE DETALLES: ALERTAS Y ÚLTIMOS CONTRATOS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.9*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel de Alertas Operativas -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="⚠️ Alertas Operativas" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="pnlAlertasContenedor">
                            <!-- Alerta de Retraso / Mora -->
                            <Border x:Name="cardAlertaMora" Background="#450A0A" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Alquileres con retraso" FontWeight="Bold" Foreground="#FCA5A5" FontSize="12"/>
                                    <TextBlock x:Name="lblAlertaMoraDesc" Text="0 contratos superaron la fecha pactada." Foreground="#F87171" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Alerta de Taller -->
                            <Border x:Name="cardAlertaTaller" Background="#2E1065" BorderBrush="#581C87" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Vehículos en taller / daños" FontWeight="Bold" Foreground="#DDD6FE" FontSize="12"/>
                                    <TextBlock x:Name="lblAlertaTallerDesc" Text="0 unidades no disponibles para alquilar." Foreground="#C4B5FD" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Mensaje si todo está en orden -->
                            <Border x:Name="cardTodoOk" Background="#064E3B" BorderBrush="#065F46" BorderThickness="1" CornerRadius="6" Padding="12" Visibility="Visible">
                                <StackPanel>
                                    <TextBlock Text="✅ Operación Normal" FontWeight="Bold" Foreground="#6EE7B7" FontSize="12"/>
                                    <TextBlock Text="No hay retrasos ni alertas críticas pendientes." Foreground="#A7F3D0" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Últimos Contratos y Movimientos -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Últimos Alquileres Registrados" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                    <DataGrid x:Name="dgvUltimosAlquileres" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="Transparent" BorderThickness="0" RowHeight="38" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                              SelectionUnit="FullRow" Foreground="White">

                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A8A"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CONTRATO" Binding="{Binding CodigoAlquiler}" Width="90" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="12,0,0,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CLIENTE" Binding="{Binding Cliente}" Width="1.3*"/>
                            <DataGridTextColumn Header="VEHÍCULO" Binding="{Binding Vehiculo}" Width="1.2*"/>
                            <DataGridTextColumn Header="SALIDA" Binding="{Binding FechaSalida, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                            <DataGridTextColumn Header="ESTADO" Binding="{Binding EstadoTexto}" Width="110" FontWeight="SemiBold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>