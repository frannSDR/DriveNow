<UserControl x:Class="DriveNow.Views.MisOperacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <UserControl.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="#1E293B" 
                                CornerRadius="6,6,0,0" 
                                Padding="16,10" 
                                Margin="0,0,4,0" 
                                Cursor="Hand">
                            <ContentPresenter x:Name="TabContent"
                                              ContentSource="Header" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              TextElement.Foreground="#94A3B8" 
                                              TextElement.FontSize="13" 
                                              TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="TabContent" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#334155"/>
                                <Setter TargetName="TabContent" Property="TextElement.Foreground" Value="#F8FAFC"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A8A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3A52"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A8A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO Y KPIS PERSONALES -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="lblTituloGestion" Text="👤 Mi Historial de Operaciones" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Resumen de reservas creadas y contratos gestionados bajo tu usuario." FontSize="13" Foreground="#94A3B8" Margin="0,2,0,12"/>

            <UniformGrid Columns="3">
                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="📝 RESERVAS REGISTRADAS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="lblTotalMisReservas" Text="0" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="🚗 ENTREGAS (CHECK-OUT)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="lblTotalMisEntregas" Text="0" FontSize="24" FontWeight="Bold" Foreground="#4ADE80" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1E293B" CornerRadius="8" Padding="15" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="🔄 RECEPCIONES (CHECK-IN)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="lblTotalMisDevoluciones" Text="0" FontSize="24" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- PESTAÑAS DE MOVIMIENTOS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- Pestaña 1: Mis Reservas -->
            <TabItem Header="Mis Reservas Creadas">
                <Border Background="#1E293B" CornerRadius="0,8,8,8" Padding="15">
                    <DataGrid x:Name="dgvMisReservas" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="Transparent" BorderThickness="0" RowHeight="42" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                              SelectionUnit="FullRow" Foreground="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoReserva}" Width="110" FontWeight="Bold"/>
                            <DataGridTextColumn Header="CLIENTE" Binding="{Binding Cliente.NombreCompleto}" Width="1.5*"/>
                            <DataGridTextColumn Header="VEHÍCULO" Binding="{Binding Vehiculo.MarcaModelo}" Width="1.5*"/>
                            <DataGridTextColumn Header="PATENTE" Binding="{Binding Vehiculo.Patente}" Width="100"/>
                            <DataGridTextColumn Header="DESDE" Binding="{Binding FechaDesde, StringFormat=\{0:dd/MM/yyyy\}}" Width="110"/>
                            <DataGridTextColumn Header="HASTA" Binding="{Binding FechaHasta, StringFormat=\{0:dd/MM/yyyy\}}" Width="110"/>
                            <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado.Nombre}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- Pestaña 2: Mis Alquileres -->
            <TabItem Header="Alquileres Entregados / Recibidos">
                <Border Background="#1E293B" CornerRadius="0,8,8,8" Padding="15">
                    <DataGrid x:Name="dgvMisAlquileres" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="Transparent" BorderThickness="0" RowHeight="42" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                              SelectionUnit="FullRow" Foreground="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CONTRATO" Binding="{Binding IdAlquiler, StringFormat='ALQ-{0:D4}'}" Width="110" FontWeight="Bold"/>
                            <DataGridTextColumn Header="CLIENTE" Binding="{Binding Reserva.Cliente.NombreCompleto}" Width="1.3*"/>
                            <DataGridTextColumn Header="VEHÍCULO" Binding="{Binding Reserva.Vehiculo.MarcaModelo}" Width="1.2*"/>
                            <DataGridTextColumn Header="PATENTE" Binding="{Binding Reserva.Vehiculo.Patente}" Width="95"/>
                            <DataGridTextColumn Header="ENTREGÓ" Binding="{Binding EmpleadoEntrega.NombreCompleto}" Width="1.2*"/>
                            <DataGridTextColumn Header="RECIBIÓ" Binding="{Binding EmpleadoDevolucion.NombreCompleto}" Width="1.2*"/>
                            <DataGridTextColumn Header="SALIDA" Binding="{Binding FechaEntregaReal, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="120"/>
                            <DataGridTextColumn Header="RETORNO" Binding="{Binding FechaEntregaDevolucion, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="120"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding CostoTotalFinal, StringFormat={}{0:C}}" Width="110" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>