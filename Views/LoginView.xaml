<Window x:Class="DriveNow.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drive Now - Autenticación" 
        Height="550" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A">

    <Grid Margin="30">
        <!-- SECCIÓN DE LOGIN -->
        <StackPanel x:Name="pnlLogin" VerticalAlignment="Center">
            <!-- Logo / Título -->
            <TextBlock Text="Drive Now" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
            <TextBlock Text="Inicia sesión para continuar" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,25"/>

            <!-- Email -->
            <TextBlock Text="Correo Electrónico" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="txtLoginEmail" Height="38" Background="#1E293B" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <!-- Contraseña -->
            <TextBlock Text="Contraseña" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtLoginPass" Height="38" Background="#1E293B" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Margin="0,0,0,25"/>

            <!-- Botón Ingresar -->
            <Button Content="Iniciar Sesión" Height="40" Background="#2563EB" Foreground="White" FontWeight="Bold" 
                    BorderThickness="0" Cursor="Hand" Click="btnIniciarSesion_Click" Margin="0,0,0,15"/>

            <!-- Cambiar a Registro -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="¿No tienes cuenta?" Foreground="#94A3B8" FontSize="12"/>
                <TextBlock Text=" Regístrate" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Cursor="Hand" 
                           MouseDown="lnkIrARegistro_MouseDown" Margin="4,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- SECCIÓN DE REGISTRO (Oculta por defecto) -->
        <StackPanel x:Name="pnlRegistro" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Crear Cuenta" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
            <TextBlock Text="Regístrate en Drive Now" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,20"/>

            <!-- Nombre -->
            <TextBlock Text="Nombre Completo" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="txtRegNombre" Height="36" Background="#1E293B" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <!-- Email -->
            <TextBlock Text="Correo Electrónico" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="txtRegEmail" Height="36" Background="#1E293B" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <!-- Contraseña -->
            <TextBlock Text="Contraseña" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtRegPass" Height="36" Background="#1E293B" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

            <!-- Botón Registrarse -->
            <Button Content="Registrar Cuenta" Height="40" Background="#10B981" Foreground="White" FontWeight="Bold" 
                    BorderThickness="0" Cursor="Hand" Click="btnRegistrarUsuario_Click" Margin="0,0,0,15"/>

            <!-- Volver a Login -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="¿Ya tienes cuenta?" Foreground="#94A3B8" FontSize="12"/>
                <TextBlock Text=" Inicia sesión" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Cursor="Hand" 
                           MouseDown="lnkIrALogin_MouseDown" Margin="4,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>