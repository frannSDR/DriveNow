<Window x:Class="DriveNow.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drive Now - Autenticación" 
        Height="620" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A">

    <Window.Resources>
        <!-- Storyboard del spinner: rota el RotateTransform "spinnerRotation" en loop infinito -->
        <Storyboard x:Key="SpinnerStoryboard">
            <DoubleAnimation Storyboard.TargetName="spinnerRotation"
                              Storyboard.TargetProperty="Angle"
                              From="0" To="360"
                              Duration="0:0:0.8"
                              RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="30">
        <!-- SECCIÓN DE LOGIN -->
        <StackPanel x:Name="pnlLogin" VerticalAlignment="Center">
            <TextBlock Text="Drive Now" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
            <TextBlock Text="Inicia sesión para continuar" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,25"/>

            <!-- Email -->
            <TextBlock Text="Correo Electrónico" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="txtLoginEmail" Height="38" Background="#1E293B" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <!-- Contraseña -->
            <TextBlock Text="Contraseña" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtLoginPass" Height="38" Background="#1E293B" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Margin="0,0,0,25"/>

            <!-- Botón Ingresar con Ruedita de Carga -->
            <Button x:Name="btnIniciarSesion" Height="40" Background="#2563EB" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnIniciarSesion_Click" Margin="0,0,0,15">
                <Grid>
                    <!-- Texto visible por defecto -->
                    <TextBlock x:Name="lblTextoBotonLogin" Text="Iniciar Sesión" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    <!-- Panel de Carga (Oculto inicialmente) -->
                    <StackPanel x:Name="pnlCargando" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse Width="16" Height="16"
                                 Stroke="White" StrokeThickness="2"
                                 StrokeDashArray="4 2"
                                 RenderTransformOrigin="0.5,0.5"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="spinnerRotation" Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text="Iniciando..." VerticalAlignment="Center" FontSize="13" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</Window>