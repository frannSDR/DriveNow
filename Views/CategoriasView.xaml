<UserControl x:Class="DriveNow.Views.CategoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Encabezado -->
            <RowDefinition Height="*"/>
            <!-- DataGrid de Categorías -->
            <RowDefinition Height="Auto"/>
            <!-- Formulario Alta / Modificación -->
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Gestión de Categorías y Tarifas Diarias" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Ajuste táctico de precios por día y tipologías de vehículos de la flota." FontSize="13" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- TABLA DE CATEGORÍAS -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Tarifario Activo" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                <DataGrid x:Name="dgvCategorias" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="Transparent" BorderThickness="0" RowHeight="42" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                          SelectionUnit="FullRow" Foreground="White">

                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A8A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A8A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A3A52"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A8A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdCategoria}" Width="70" FontWeight="Bold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="16,0,0,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="Padding" Value="16,0,10,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Nombre}" Width="150" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="2*"/>
                        <DataGridTextColumn Header="TARIFA DIARIA" Binding="{Binding TarifaDiaria, StringFormat={}{0:C}}" Width="150" FontWeight="Bold"/>

                        <!-- Columna de Acciones -->
                        <DataGridTemplateColumn x:Name="colAccionesCategorias" Header="ACCIONES" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✏️" Background="Transparent" Foreground="#38BDF8" 
                                                BorderThickness="0" Cursor="Hand" ToolTip="Editar tarifa o detalles"
                                                Click="btnEditarCategoria_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- FORMULARIO DE ALTA / MODIFICACIÓN -->
        <Border x:Name="pnlFormularioCategorias" Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="15">
            <StackPanel>
                <TextBlock x:Name="lblTituloFormularioCat" Text="➕ Nueva Categoría" 
                           FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Nombre de Categoría" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtNombre" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="Tarifa Diaria ($)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTarifaDiaria" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Descripción / Ejemplos" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtDescripcion" Height="34" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6"/>
                </StackPanel>

                <!-- Botones de Acción -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCancelarEdicion" Content="Cancelar" Width="100" Height="35" 
                            Background="#475569" Foreground="White" BorderThickness="0" 
                            Margin="0,0,10,0" Cursor="Hand" Visibility="Collapsed" 
                            Click="btnCancelarEdicion_Click"/>

                    <Button x:Name="btnLimpiarCat" Content="Limpiar" Width="100" Height="35" 
                            Background="#334155" Foreground="White" BorderThickness="0" 
                            Margin="0,0,10,0" Cursor="Hand" 
                            Click="btnLimpiarCat_Click"/>

                    <Button x:Name="btnGuardarCategoria" Content="Guardar Categoría" Width="150" Height="35" 
                            Background="#2563EB" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Cursor="Hand" 
                            Click="btnGuardarCategoria_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>